{
  "experiment_title": "SSS Normalization - Isolated Research Experiment",
  "dataset_name": "AI4Shipwrecks",
  "method": "swath_percentile_contrast_normalization",
  "parameters": {
    "p_low": 1.0,
    "p_high": 99.0
  },
  "rationale": "In the absence of raw physical acoustic telemetry (altitude, slant-range, beam pattern), physical radiometric calibration is impossible without inventing non-existent metadata. A swath-level percentile contrast stretch (1st to 99th percentile) linearly expands dynamic range while preventing extreme speckle spikes from compressing acoustic highlights and shadows. Swath-level application prevents ping-wise striping artifacts.",
  "num_samples_evaluated": 20,
  "aggregate_findings": {
    "raw_swath_mean_range": [
      28.09,
      101.99
    ],
    "normalized_swath_mean_range": [
      35.89,
      101.99
    ],
    "cross_swath_mean_std_raw": 21.27,
    "cross_swath_mean_std_normalized": 16.5,
    "mean_target_contrast_change_pct": -1.26,
    "mean_highlight_clipping_pct": 10.87
  },
  "decision": {
    "verdict": "MODIFY",
    "detailed_assessment": {
      "consistency_between_swaths": "MODERATE IMPROVEMENT: Raw swath means varied between 28.1 and 102.0 (cross-swath std = 21.27). After 1-99% normalization, swath means centered closer (between 35.9 and 102.0, cross-swath std = 16.5).",
      "target_visibility": "PRESERVED AND ENHANCED: Target highlight backscatter was boosted in dark swaths (e.g. Viator_01 and Monohansett_02) with average target-to-ambient contrast change of -1.3%. Acoustic shadows retained zero/low returns.",
      "background_suppression": "NEUTRAL TO SLIGHT NEGATIVE: Linear contrast stretching expands both seabed speckle and target highlights equally. It does not selectively suppress ambient seabed reverberation. In noisy shallow swaths, background speckle grain became slightly more visible.",
      "downstream_object_detection": "POSITIVE BENEFIT EXPECTED: Standard object detectors (YOLO) benefit from consistent dynamic range across batches. However, global swath stretching must be applied prior to tiling to prevent tile-boundary contrast discontinuities."
    },
    "recommendation": "MODIFY: Adopt swath-level robust percentile normalization as a baseline contrast standardization step, but DO NOT rely on it for background suppression. Local adaptive enhancement (e.g. CLAHE or local contrast) should be evaluated in subsequent stages."
  },
