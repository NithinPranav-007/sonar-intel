# SONAR-INTEL Backend Environment Configuration (Render / Production)

# Database
# PostGIS PostgreSQL URI: postgresql+psycopg://user:password@hostname:5432/dbname
# On Render: copy the "Internal Database URL" from your Render PostgreSQL instance.
# If connection fails or is left blank, backend automatically falls back to local SQLite mode!
DATABASE_URL=

# Server Configuration (Render automatically sets PORT)
PORT=8000
BACKEND_HOST=0.0.0.0
# Allowed frontend origins (comma-separated). Set this to your Vercel deployment URL:
ALLOWED_ORIGINS=https://sonar-intel.vercel.app,http://localhost:5173,http://localhost:5174
FRONTEND_URL=https://sonar-intel.vercel.app
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# Storage Paths (relative to repository root or absolute)
STORAGE_RAW_DIR=data/raw
STORAGE_PROCESSED_DIR=data/processed
STORAGE_OUTPUTS_DIR=outputs
DEMO_DATA_DIR=data/demo

# ML Inference & Hugging Face Hybrid Architecture
MODEL_PATH=ml/models/best_distilled_yolo11n.pt
INFERENCE_PROVIDER=hybrid
HF_SPACE=awzsxde/marine-sonar-ai
HF_API_ENDPOINT=/predict
HF_API_ENABLED=true
HF_API_TIMEOUT=60
# Hugging Face Token (Loaded from environment, NEVER hardcoded or exposed)
HF_TOKEN=
HF_MODEL_ID=Samyukta31/sonar_yolo
HF_MODEL_FILE=best_distilled_yolo11n.pt
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
DEVICE=cpu

# Low-Memory Thread Limits (< 512MB RAM)
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2
