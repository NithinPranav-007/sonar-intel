# SONAR-INTEL Backend Environment Configuration

# Database
# PostGIS URI: postgresql+psycopg://sonar_user:sonar_password@localhost:5432/sonar_intel
# If connection fails or is left blank, backend automatically falls back to local SQLite/Memory mode!
DATABASE_URL=postgresql+psycopg://sonar_user:sonar_password@localhost:5432/sonar_intel

# Storage paths
STORAGE_RAW_DIR=../data/raw
STORAGE_PROCESSED_DIR=../data/processed
STORAGE_OUTPUTS_DIR=../outputs

# ML Settings
YOLO_MODEL_PATH=../ml/models/yolov8n.pt
INFERENCE_CONFIDENCE_THRESHOLD=0.25
INFERENCE_DEVICE=cpu

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
