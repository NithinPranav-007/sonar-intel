# ==============================================================================
# SONAR-INTEL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Multi-Class Acoustic Marine Debris & Ghost-Net Detection System
# Copy this file to .env and customize as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
BACKEND_HOST=0.0.0.0
RELOAD=false

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND CLIENT URLS
# ------------------------------------------------------------------------------
# Primary Vercel production frontend
FRONTEND_URL=https://frontend-sigma-bay-90.vercel.app

# Comma-separated list of allowed origins (production, preview branches, and local dev)
ALLOWED_ORIGINS=https://frontend-sigma-bay-90.vercel.app,https://frontend-git-main-nithins-projects-6f09c2d3.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000,http://127.0.0.1:3000

# Regex pattern matching any Vercel preview or production deployment
CORS_ORIGIN_REGEX=^https:\/\/.*\.vercel\.app$

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Optional PostgreSQL / PostGIS connection string:
# Format: postgresql+psycopg://username:password@hostname:5432/dbname
# If left empty, SONAR-INTEL automatically activates zero-config local SQLite mode.
DATABASE_URL=

# ------------------------------------------------------------------------------
# 4. STORAGE DIRECTORIES (Relative to repository root or absolute)
# ------------------------------------------------------------------------------
STORAGE_RAW_DIR=data/raw
STORAGE_PROCESSED_DIR=data/processed
STORAGE_OUTPUTS_DIR=outputs
DEMO_DATA_DIR=data/demo

# ------------------------------------------------------------------------------
# 5. AI DETECTOR & ML INFERENCE SETTINGS
# ------------------------------------------------------------------------------
# Checkpoint model path (lightweight distilled YOLO11n backbone, ~5.2 MB)
MODEL_PATH=ml/models/best_distilled_yolo11n.pt
MODEL_NAME=DRISHTI-YOLO11n
MODEL_VERSION=distilled-v1
INFERENCE_PROVIDER=local
DEVICE=cpu

# Detection thresholds
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45
IMAGE_SIZE=640

# Hugging Face fallback repository if model checkpoint is missing locally
HF_MODEL_ID=Samyukta31/sonar_yolo
HF_MODEL_FILE=best_distilled_yolo11n.pt
HF_TOKEN=

# ------------------------------------------------------------------------------
# 6. ACOUSTIC PREPROCESSING (DRISHTI Specification)
# ------------------------------------------------------------------------------
PREPROCESSING_VERSION=drishti-prep-v1
PREPROCESSING_SPECKLE_FILTER=lee
PREPROCESSING_CLAHE=true
LEE_WINDOW_SIZE=5
LEE_NOISE_VAR=0.04
CLAHE_CLIP_LIMIT=2.0
CLAHE_GRID_X=8
CLAHE_GRID_Y=8

# ------------------------------------------------------------------------------
# 7. PRODUCT SAFETY GUARDRAILS & RESOURCE LIMITS (< 512MB RAM)
# ------------------------------------------------------------------------------
MAX_SONAR_FILE_SIZE=26214400    # 25 MB max sonar upload
MAX_NAV_FILE_SIZE=5242880       # 5 MB max navigation track
MAX_IMAGE_PIXELS=25000000       # 25 Megapixels maximum

# Low-memory multi-threading constraints to prevent memory fragmentation on CPU
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1
MALLOC_ARENA_MAX=2
